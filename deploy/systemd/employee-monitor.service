[Unit]
Description=Employee Monitoring System
After=network.target

[Service]
Type=simple
User=monitor
WorkingDirectory=/opt/employee-monitor
ExecStart=/opt/employee-monitor/venv/bin/python src/main_production.py --source videos/sample.mp4 --device cpu --enable-activity-recognition --enable-attendance --display
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
