{
  "cameras": [
    { "name": "webcam_0", "source": 0 },
    { "name": "test_video", "source": "videos/sample.mp4" }
  ],
  "yolo": {
    "model": "yolov8s.pt",
    "imgsz": 416,
    "confidence": 0.35,
    "device": "cpu"
  },
  "level2_processor": {
    "enable_advanced_ai": true,
    "enable_face_recognition": true,
    "enable_activity_recognition": true,
    "activity_window": 15,
    "frame_skip": 3,
    "max_duration": 300
  },
  "tracking": {
    "type": "bytetrack",
    "track_high_thresh": 0.6,
    "track_low_thresh": 0.1,
    "new_track_thresh": 0.7,
    "max_age": 30,
    "match_thresh": 0.8
  },
  "attendance": {
    "grace_seconds": 900
  },
  "reports": {
    "daily_time": "17:00",
    "timezone": "Africa/Cairo",
    "output_dir": "reports",
    "filename_pattern": "report_%Y-%m-%d",
    "formats": ["csv", "xlsx"]
  }
}
