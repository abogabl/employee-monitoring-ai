# Python
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv/
venv/
ENV/

# IDEs
.vscode/
.idea/
*.code-workspace

# Logs and reports
logs/
reports/*.csv
reports/*.xlsx

# OS
.DS_Store
Thumbs.db

# Cache
*.cache/
.cache/

# Models and large files (optional)
models/
videos/

# YOLO Models (كبيرة جداً!)
*.pt
yolov8*.pt

# Test videos and uploads - ignore everything
web_app/static/uploads/test_videos/

# Database backups
attendance_db/backups/*.db
attendance_db/backups/.last_*

# Keep folder structure with .gitkeep
!models/.gitkeep
!videos/.gitkeep
!logs/.gitkeep
!web_app/static/uploads/test_videos/.gitkeep
